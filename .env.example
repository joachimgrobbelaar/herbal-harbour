# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# Social Media Cross-Posting Automation Configuration (Milestone 3 / R3)
# ==============================================================================
# Rule 6 Graceful Standby: When credentials below are unset or set to placeholders,
# the cross-posting service automatically operates in non-destructive mock/standby mode.

CROSSPOST_ENABLED=true
CROSSPOST_POLL_INTERVAL=300
# CROSSPOST_STANDBY_MODE options:
#   auto: automatically use mock mode if platform credentials are unconfigured.
#   live: enforce live network API requests (fails if tokens missing or invalid).
#   mock: force simulation mode for testing regardless of credentials.
CROSSPOST_STANDBY_MODE=auto

# --- Instagram Graph API (Meta for Developers) ---
# Requires Instagram Business or Creator Account linked to a Facebook Page.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_VERIFY_TOKEN=herbal_harbour_ig_verify_2026

# --- YouTube Data API v3 (Google Cloud Console) ---
# Resumable video upload to YouTube Shorts with #Shorts tag.
# Standard quota: 10,000 units/day (~6 video uploads/day at 1,600 units/video).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CLIENT_SECRETS_FILE=
YOUTUBE_PRIVACY_STATUS=public  # Options: public | unlisted | private

# --- TikTok Content Posting API v2 (TikTok for Developers) ---
# Direct publishing requires approved 'video.publish' scope.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE  # Options: PUBLIC_TO_EVERYONE | MUTUAL_FOLLOW_FRIENDS | SELF_ONLY

# --- Storage & Persistence ---
CROSSPOST_DB_PATH=data/crosspost.db
CROSSPOST_MEDIA_DIR=/tmp/herbal_harbour_crosspost
