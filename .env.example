# Copy to .env.local. Vite only exposes variables that start with VITE_.
# These Firebase web-app values are client identifiers. They are still not
# committed. Do not put a Gemini key, a service-account JSON, or any private
# API key in a VITE_ variable — that would ship it to the browser.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=gemini-dream-477009.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=gemini-dream-477009
VITE_FIREBASE_STORAGE_BUCKET=gemini-dream-477009.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side only. Used by `npm run seed` and `npm run make-admin`.
# Point at a downloaded service-account JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# or paste the JSON on one line (never commit it):
# FIREBASE_SERVICE_ACCOUNT=

# Optional Cloud Function settings live in functions/.env (not committed).
# SHEETS_SPREADSHEET_ID=
# SHEETS_SERVICE_ACCOUNT=
