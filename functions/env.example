# Copy to functions/.env before deploying the Cloud Function.
# Leave these blank and the function no-ops. The shop still works.
# SHEETS_SPREADSHEET_ID is the id in the Google Sheet URL
# (.../spreadsheets/d/THIS/edit). The admin desk can also save it to
# Firestore config/sheets, which the function reads when this is empty.
SHEETS_SPREADSHEET_ID=

# Optional. One-line JSON for a service account that can edit the sheet.
# If empty, the function uses its own runtime service account.
# Share the sheet with that account as an Editor.
SHEETS_SERVICE_ACCOUNT=
