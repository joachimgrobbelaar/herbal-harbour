    const { data, error } = await supabase.functions.invoke('spin');

    clearInterval(ticker);
    setIsSpinning(false);

    if (error) {
      setMessage(`Spin failed: ${error.message}`);
      return;
    }

    // Animate to the server's answer
    setReels(data.symbols);

    if (data.payout > 0) {
      setLastPayout(data.payout);
      setMessage(`🎉 Winner! R${data.payout} credited to your wallet.`);
    } else {
      setMessage('So close — try again!');
    }

    await refresh(); // pull new balance + free spin count
