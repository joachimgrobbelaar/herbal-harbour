2. RPC: apply_wallet_to_order

The checkout atomically debits the wallet and inserts the order — or fails entirely. No "debited but order failed" state.

supabase/migrations/20261028000003_apply_wallet.sql
sql

create or replace function public.apply_wallet_to_order(
  p_order jsonb,           -- full order payload from client
  p_wallet_amount numeric  -- amount of wallet credit to apply
)
returns json
language plpgsql
security definer
set search_path = public
as $$
declare
  v_user_id uuid := auth.uid();
  v_balance numeric;
  v_total numeric;
  v_order_id uuid;
begin
  if v_user_id is null then
    raise exception 'Not authenticated';
  end if;

  if p_wallet_amount < 0 then
    raise exception 'Wallet amount must be non-negative';
  end if;

  -- Lock the profile row
  select wallet_balance into v_balance
    from profiles
   where id = v_user_id
   for update;

  if v_balance < p_wallet_amount then
    raise exception 'Insufficient wallet balance';
  end if;

  -- Compute the final total client-side, but validate server-side
  v_total := (p_order->>'total')::numeric;

  if v_total < 0 then
    raise exception 'Total cannot be negative';
  end if;

  -- Debit wallet
  update profiles
     set wallet_balance = wallet_balance - p_wallet_amount
   where id = v_user_id;

  -- Insert order
  insert into orders (
    user_id, order_number, customer_name, email, phone,
    address, city, postal_code, province, items,
    subtotal, discount, shipping, wallet_applied, total, payment_method
  )
  values (
    v_user_id,
    p_order->>'order_number',
    p_order->>'customer_name',
    p_order->>'email',
    p_order->>'phone',
    p_order->>'address',
    p_order->>'city',
    p_order->>'postal_code',
    p_order->>'province',
    p_order->'items',
    (p_order->>'subtotal')::numeric,
    (p_order->>'discount')::numeric,
    (p_order->>'shipping')::numeric,
    p_wallet_amount,
    v_total,
    p_order->>'payment_method'
  )
  returning id into v_order_id;

  return json_build_object(
    'order_id', v_order_id,
    'new_wallet_balance', v_balance - p_wallet_amount
  );
end;
$$;

revoke execute on function public.apply_wallet_to_order from public, anon;
grant execute on function public.apply_wallet_to_order to authenticated;

Why this is safe: auth.uid() is set by the JWT, which is signed by Supabase. Even if the browser tries to spoof p_order.user_id, the function never reads it — it uses auth.uid() exclusively.
