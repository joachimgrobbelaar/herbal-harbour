4. Admin RPCs

supabase/migrations/20261028000004_admin_rpcs.sql
sql

-- Credit a user's wallet (admin only)
create or replace function public.admin_credit_wallet(
  p_target_email text,
  p_amount numeric,
  p_reason text default 'Manual top-up'
)
returns json
language plpgsql
security definer
set search_path = public
as $$
declare
  v_target_id uuid;
  v_new_balance numeric;
begin
  if not public.is_admin() then
    raise exception 'Forbidden: admin only';
  end if;

  if p_amount = 0 then
    raise exception 'Amount cannot be zero';
  end if;

  select id into v_target_id from auth.users where email = p_target_email;
  if v_target_id is null then
    raise exception 'No user with email %', p_target_email;
  end if;

  update profiles
     set wallet_balance = wallet_balance + p_amount
   where id = v_target_id
   returning wallet_balance into v_new_balance;

  insert into spin_log (user_id, cost, payout, symbols, is_free)
  values (v_target_id, 0, p_amount, array['💰', '💰', '💰'], false);

  return json_build_object(
    'user_id', v_target_id,
    'new_balance', v_new_balance,
    'reason', p_reason
  );
end;
$$;

revoke execute on function public.admin_credit_wallet from public, anon;
grant execute on function public.admin_credit_wallet to authenticated;

