-- ─────────────────────────────────────────────────────────────
-- profiles: extends auth.users with wallet + spin state
-- ─────────────────────────────────────────────────────────────
create table public.profiles (
  id                  uuid primary key references auth.users on delete cascade,
  display_name        text,
  wallet_balance      numeric(10,2) not null default 0
                      check (wallet_balance >= 0),
  free_spins_remaining int not null default 3
                      check (free_spins_remaining between 0 and 3),
  created_at          timestamptz not null default now()
);

alter table public.profiles enable row level security;

-- Users can read/update their own profile, but ONLY the columns
-- that are safe to touch from the client (display_name).
-- wallet_balance and free_spins_remaining are mutated exclusively
-- by the `spin` Edge Function using the service-role key.
create policy "read own profile"
  on public.profiles for select
  using (auth.uid() = id);

create policy "update own display name"
  on public.profiles for update
  using (auth.uid() = id)
  with check (auth.uid() = id);

-- Auto-create a profile row whenever a user signs up
create function public.handle_new_user()
returns trigger
language plpgsql
security definer set search_path = public
as $$
begin
  insert into public.profiles (id, display_name)
  values (
    new.id,
    coalesce(new.raw_user_meta_data->>'full_name', new.email)
  );
  return new;
end;
$$;

create trigger on_auth_user_created
  after insert on auth.users
  for each row execute function public.handle_new_user();

-- ─────────────────────────────────────────────────────────────
-- spin_log: immutable audit trail. Every spin = one row.
-- ─────────────────────────────────────────────────────────────
create table public.spin_log (
  id          uuid primary key default gen_random_uuid(),
  user_id     uuid not null references public.profiles(id) on delete cascade,
  cost        numeric(10,2) not null check (cost >= 0),
  payout      numeric(10,2) not null check (payout >= 0),
  symbols     text[] not null check (array_length(symbols, 1) = 3),
  is_free     boolean not null,
  created_at  timestamptz not null default now()
);

create index spin_log_user_created_idx on public.spin_log (user_id, created_at desc);

alter table public.spin_log enable row level security;

create policy "read own spin log"
  on public.spin_log for select
  using (auth.uid() = user_id);

-- Inserts only via service role (Edge Function). No client insert policy.

Why RLS matters here: without it, a user could open DevTools, call supabase.from('profiles').update({ wallet_balance: 999999 }), and drain your business. The only writes to wallet_balance happen through the Edge Function using the service-role key — which never leaves the server.
2. Edge Function — spin

supabase/functions/spin/index.ts
ts

import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

const CORS = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type',
};

const SYMBOLS = ['🍒', '🍏', '🍊', '🔔', '⭐'] as const;

// Prize table — payout in ZAR. Must match client display.
const PRIZES: Record<string, number> = {
  '🍒': 20,
  '🍏': 30,
  '🍊': 50,
  '🔔': 100,
  '⭐': 500,
};

const PAID_SPIN_COST = 10;
const WIN_CHANCE = 0.18;

function rollSymbols(): { symbols: string[]; payout: number } {
  const willWin = Math.random() < WIN_CHANCE;

  if (!willWin) {
    // Near-miss: two random + one different
    const a = SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)];
    const b = SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)];
    const c = SYMBOLS[(SYMBOLS.indexOf(a) + 1) % SYMBOLS.length];
    return { symbols: [a, b, c], payout: 0 };
  }

  // Weighted win: cherry most likely, star <1%
  const r = Math.random();
  let chosen: string;
  if (r < 0.55) chosen = '🍒';
  else if (r < 0.80) chosen = '🍏';
  else if (r < 0.93) chosen = '🍊';
  else if (r < 0.99) chosen = '🔔';
  else chosen = '⭐';

  return { symbols: [chosen, chosen, chosen], payout: PRIZES[chosen] };
}

Deno.serve(async (req) => {
  if (req.method === 'OPTIONS') return new Response('ok', { headers: CORS });

  try {
    // ── 1. Auth ────────────────────────────────────────────────
    const authHeader = req.headers.get('Authorization');
    if (!authHeader) {
      return json({ error: 'Not authenticated' }, 401);
    }

    const supabase = createClient(
      Deno.env.get('SUPABASE_URL')!,
      Deno.env.get('SUPABASE_SERVICE_ROLE_KEY')!, // service role — never exposed
      { global: { headers: { Authorization: authHeader } } }
    );

    const { data: userData, error: userErr } = await supabase.auth.getUser();
    if (userErr || !userData.user) {
      return json({ error: 'Invalid session' }, 401);
    }
    const userId = userData.user.id;

    // ── 2. Load profile ───────────────────────────────────────
    const { data: profile, error: profErr } = await supabase
      .from('profiles')
      .select('wallet_balance, free_spins_remaining')
      .eq('id', userId)
      .single();

    if (profErr || !profile) return json({ error: 'Profile not found' }, 404);

    // ── 3. Decide: free or paid? ──────────────────────────────
    const isFree = profile.free_spins_remaining > 0;
    const cost = isFree ? 0 : PAID_SPIN_COST;

    if (!isFree && profile.wallet_balance < PAID_SPIN_COST) {
      return json({
        error: 'Insufficient wallet balance',
        wallet_balance: profile.wallet_balance,
        required: PAID_SPIN_COST,
      }, 402);
    }

    // ── 4. Server-side RNG ────────────────────────────────────
    const { symbols, payout } = rollSymbols();

    // ── 5. Atomic update via Postgres function ────────────────
    // We use an RPC so the balance check + deduction + payout
    // happen in one transaction (no race conditions on double-tap).
    const { data: result, error: rpcErr } = await supabase.rpc('perform_spin', {
      p_user_id: userId,
      p_cost: cost,
      p_payout: payout,
      p_symbols: symbols,
      p_is_free: isFree,
    });

    if (rpcErr) return json({ error: rpcErr.message }, 500);

    return json({
      symbols,
      payout,
      cost,
      is_free: isFree,
      new_balance: result.new_balance,
      free_spins_remaining: result.free_spins_remaining,
    }, 200);
  } catch (e) {
    return json({ error: (e as Error).message }, 500);
  }
});

function json(body: unknown, status = 200) {
  return new Response(JSON.stringify(body), {
    status,
    headers: { ...CORS, 'Content-Type': 'application/json' },
  });
}

3. Postgres RPC — atomic spin

supabase/migrations/20261028000001_perform_spin.sql
sql

create or replace function public.perform_spin(
  p_user_id uuid,
  p_cost numeric,
  p_payout numeric,
  p_symbols text[],
  p_is_free boolean
)
returns json
language plpgsql
security definer
set search_path = public
as $$
declare
  v_balance numeric;
  v_free int;
begin
  -- Lock the row to prevent concurrent spins from racing
  select wallet_balance, free_spins_remaining
    into v_balance, v_free
    from profiles
   where id = p_user_id
   for update;

  if not found then
    raise exception 'Profile not found';
  end if;

  -- Re-validate on the DB side (defence in depth)
  if p_is_free then
    if v_free <= 0 then
      raise exception 'No free spins remaining';
    end if;
  else
    if v_balance < p_cost then
      raise exception 'Insufficient balance';
    end if;
  end if;

  -- Apply changes atomically
  update profiles
     set wallet_balance = wallet_balance - p_cost + p_payout,
         free_spins_remaining = case when p_is_free
                                      then free_spins_remaining - 1
                                      else free_spins_remaining
                                 end
   where id = p_user_id
   returning wallet_balance, free_spins_remaining
        into v_balance, v_free;

  -- Audit log
  insert into spin_log (user_id, cost, payout, symbols, is_free)
  values (p_user_id, p_cost, p_payout, p_symbols, p_is_free);

  return json_build_object(
    'new_balance', v_balance,
    'free_spins_remaining', v_free
  );
end;
$$;

-- Only the service role (Edge Function) may call this
revoke execute on function public.perform_spin from public, anon, authenticated;
grant execute on function public.perform_spin to service_role;

