        </p>

        <label className="block text-xs font-semibold text-slate-700 mb-1">
          Amount (R) — use negative to debit
        </label>
        <input
          type="number"
          value={amount}
          onChange={e => setAmount(e.target.value)}
          step="0.01"
          className="w-full mb-3 px-3 py-2 rounded-lg border border-slate-200 outline-none focus:border-emerald-500 font-mono"
        />

        <label className="block text-xs font-semibold text-slate-700 mb-1">
          Reason (visible in audit log)
        </label>
        <input
          type="text"
          value={reason}
          onChange={e => setReason(e.target.value)}
          className="w-full mb-4 px-3 py-2 rounded-lg border border-slate-200 outline-none focus:border-emerald-500"
        />

        {error && (
          <div className="mb-3 p-2 rounded-lg bg-rose-50 border border-rose-200 text-xs text-rose-700">
