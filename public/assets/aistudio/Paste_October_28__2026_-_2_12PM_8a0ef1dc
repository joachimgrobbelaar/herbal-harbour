        </div>
      </Shell>
    );
  }

  const isFree = (profile?.free_spins_remaining ?? 0) > 0;
  const canAfford = isFree || (profile?.wallet_balance ?? 0) >= PAID_SPIN_COST;

  return (
    <Shell onClose={onClose}>
      {/* Wallet + free spin status */}
      <div className="grid grid-cols-2 gap-3 mb-5">
        <div className="bg-black/30 rounded-xl p-3 border border-amber-500/20">
          <div className="flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-amber-300 mb-1">
            <Wallet className="w-3 h-3" /> Wallet
          </div>
          <div className="text-lg font-mono font-bold">
            R{(profile?.wallet_balance ?? 0).toFixed(2)}
          </div>
        </div>
        <div className="bg-black/30 rounded-xl p-3 border border-emerald-500/20">
          <div className="flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-emerald-300 mb-1">
            <Gift className="w-3 h-3" /> Free Spins
          </div>
          <div className="text-lg font-mono font-bold">
            {profile?.free_spins_remaining ?? 0} / 3
          </div>
        </div>
      </div>

      {/* Reels */}
      <div className="grid grid-cols-3 gap-3 bg-[#0a1411] p-3 rounded-xl border border-emerald-950 mb-4">
        {reels.map((s, i) => (
