      options: { redirectTo: window.location.origin },
    });
  };

  const handleSpin = async () => {
    if (isSpinning || !profile) return;

    const isFree = profile.free_spins_remaining > 0;
    const canAfford = isFree || profile.wallet_balance >= PAID_SPIN_COST;
    if (!canAfford) {
      setMessage('Not enough wallet balance — top up to keep spinning.');
      return;
    }

    setIsSpinning(true);
    setLastPayout(null);
    setMessage(isFree ? 'Spinning (free)…' : `Spinning — R${PAID_SPIN_COST}…`);

