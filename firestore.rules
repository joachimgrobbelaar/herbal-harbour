rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || (
          exists(/databases/$(database)/documents/roles/$(request.auth.uid))
          && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.admin == true
        )
      );
    }

    function orderPath(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    function stockTouchOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['stock', 'inStock', 'updatedAt', 'lastStockOrderId']);
    }

    function stockShape() {
      return request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.inStock is bool
        && request.resource.data.inStock == (request.resource.data.stock > 0)
        && request.resource.data.lastStockOrderId is string
        && request.resource.data.lastStockOrderId.size() > 0
        && request.resource.data.lastStockOrderId.size() < 200;
    }

    // A customer (or the same transaction) may only reduce stock by creating
    // their own pending online order in this commit, for exactly that quantity.
    function validCheckoutDecrement(productId) {
      let orderId = request.resource.data.lastStockOrderId;
      let path = orderPath(orderId);
      let qty = resource.data.stock - request.resource.data.stock;
      return signedIn()
        && stockTouchOnly()
        && stockShape()
        && resource.data.stock is int
        && qty is int
        && qty > 0
        && !exists(path)
        && existsAfter(path)
        && getAfter(path).data.userId == request.auth.uid
        && getAfter(path).data.channel == 'online'
        && getAfter(path).data.status == 'pending'
        && getAfter(path).data.stockApplied == true
        && getAfter(path).data.quantities[productId] == qty;
    }

    // Restock is allowed only while an existing pending/paid order becomes cancelled.
    function validCancelRestock(productId) {
      let orderId = request.resource.data.lastStockOrderId;
      let path = orderPath(orderId);
      let qty = request.resource.data.stock - resource.data.stock;
      return signedIn()
        && stockTouchOnly()
        && stockShape()
        && resource.data.stock is int
        && qty is int
        && qty > 0
        && exists(path)
        && get(path).data.quantities[productId] == qty
        && get(path).data.status in ['pending', 'paid']
        && getAfter(path).data.status == 'cancelled'
        && (
          isAdmin()
          || get(path).data.userId == request.auth.uid
        );
    }

    function validOnlineOrder() {
      let data = request.resource.data;
      return data.userId == request.auth.uid
        && data.channel == 'online'
        && data.status == 'pending'
        && data.paymentMethod in ['eft', 'pay_on_collection']
        && data.stockApplied == true
        && data.customerName is string
        && data.customerName.size() > 0
        && data.customerName.size() < 200
        && data.email is string
        && data.email.size() > 3
        && data.email.size() < 200
        && data.phone is string
        && data.phone.size() > 0
        && data.phone.size() < 40
        && data.address is string
        && data.address.size() > 0
        && data.city is string
        && data.city.size() > 0
        && data.province is string
        && data.postalCode is string
        && data.notes is string
        && data.orderNumber is string
        && data.quantities is map
        && data.quantities.size() > 0
        && data.quantities.size() <= 50
        && data.items is list
        && data.items.size() == data.quantities.size()
        && data.subtotal is number
        && data.discount is number
        && data.shipping is number
        && data.total is number
        && data.total >= 0;
    }

    function validPosOrder() {
      let data = request.resource.data;
      return data.userId == request.auth.uid
        && data.channel == 'pos'
        && data.status in ['pending', 'paid', 'collected']
        && data.paymentMethod in ['eft', 'pay_on_collection']
        && data.stockApplied == true
        && data.customerName is string
        && data.quantities is map
        && data.quantities.size() > 0
        && data.items is list
        && data.subtotal is number
        && data.total is number
        && data.total >= 0;
    }

    function statusChangeOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'updatedAt', 'cancelledAt', 'paidAt', 'collectedAt']);
    }

    function validStatusTransition() {
      let from = resource.data.status;
      let to = request.resource.data.status;
      return (from == 'pending' && to in ['paid', 'collected', 'cancelled'])
        || (from == 'paid' && to in ['collected', 'cancelled']);
    }

    function validSaleMovement() {
      let data = request.resource.data;
      let path = orderPath(data.orderId);
      return signedIn()
        && data.userId == request.auth.uid
        && data.delta is int
        && data.delta < 0
        && data.channel == 'online'
        && data.productId is string
        && data.orderId is string
        && !exists(path)
        && existsAfter(path)
        && getAfter(path).data.userId == request.auth.uid
        && getAfter(path).data.channel == 'online'
        && getAfter(path).data.quantities[data.productId] == (0 - data.delta);
    }

    function validCancelMovement() {
      let data = request.resource.data;
      let path = orderPath(data.orderId);
      return signedIn()
        && data.userId == request.auth.uid
        && data.delta is int
        && data.delta > 0
        && data.channel == 'cancel'
        && data.productId is string
        && data.orderId is string
        && exists(path)
        && get(path).data.quantities[data.productId] == data.delta
        && get(path).data.status in ['pending', 'paid']
        && getAfter(path).data.status == 'cancelled'
        && (isAdmin() || get(path).data.userId == request.auth.uid);
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || validCheckoutDecrement(productId)
        || validCancelRestock(productId);
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if (signedIn() && validOnlineOrder()) || (isAdmin() && validPosOrder());
      allow update: if statusChangeOnly() && (
        (isAdmin() && validStatusTransition())
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
        )
      );
      allow delete: if false;
    }

    match /stockMovements/{movementId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || validSaleMovement() || validCancelMovement();
      allow update, delete: if false;
    }

    match /carts/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 100;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /roles/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && docId == 'sheets'
        && request.resource.data.keys().hasOnly(['spreadsheetId', 'updatedAt'])
        && request.resource.data.spreadsheetId is string
        && request.resource.data.spreadsheetId.size() < 200;
      allow delete: if false;
    }
  }
}
